{
  "name": "solara",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "prepack": "run-s lint build",
    "lint": "run-s typeCheck eslint",
    "eslint": "eslint --fix ./src",
    "typeCheck": "tsc --project ./ --noEmit",
    "test": "tsx ./src/test.ts",
    "test:vitest": "vitest",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run"
  },
  "keywords": [
    "wyntine",
    "typescript",
    "solara",
    "discord"
  ],
  "author": "Wyntine",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@tsconfig/strictest": "^2.0.5",
    "@types/eslint__js": "^8.42.3",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.15",
    "@types/node": "^22.13.1",
    "@wyntine/prettier-config": "^1.1.1",
    "npm-run-all": "^4.1.5",
    "prettier-eslint": "^16.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vitest": "^3.0.5"
  },
  "prettier": "@wyntine/prettier-config",
  "homepage": "https://github.com/Wyntine/Solara#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wyntine/Solara.git"
  },
  "bugs": {
    "url": "https://github.com/Wyntine/Solara/issues"
  },
  "dependencies": {
    "@wyntine/verifier": "1.0.0-beta.3",
    "chalk": "^5.4.1",
    "discord.js": "^14.17.3",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.21"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
